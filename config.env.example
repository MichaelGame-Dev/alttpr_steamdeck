# ALttPR launcher config. Copied to ~/.config/alttpr-launcher/config.env by install.sh.
# This file is sourced by bash, so quote values and use $HOME rather than ~.

# Clean (unheadered) JP 1.0 ROM, MD5 03a63945398191337e896e5771f77173.
# install.sh writes a validated copy here.
BASE_ROM="$HOME/.local/share/alttpr-launcher/base_jp10.sfc"

# Where patched seeds are written. Empty = auto: ~/Emulation/roms/snes/alttpr if EmuDeck is set up,
# otherwise ~/.local/share/alttpr-launcher/seeds.
SEED_DIR=""

# Preset JSON (relative paths resolve against the repo directory).
PRESET="presets/beginner.json"

# Command that launches the emulator; the ROM path is appended as the last argument.
# Default: RetroArch flatpak (as installed by EmuDeck) with the snes9x core.
RETROARCH_CMD=(flatpak run org.libretro.RetroArch -L "$HOME/.var/app/org.libretro.RetroArch/config/retroarch/cores/snes9x_libretro.so")
# Native RetroArch (e.g. Arch package):
# RETROARCH_CMD=(retroarch -L /usr/lib/libretro/snes9x_libretro.so)
